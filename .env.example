# Copy to .env (git-ignored) and fill in what you need.

# --- Council (all optional; defaults shown) ---
# COUNCIL_MEMBERS=chatgpt,claude,grok
# COUNCIL_CHAIRMAN=claude
# COUNCIL_TITLE_MEMBER=grok
# COUNCIL_TIMEOUT=300
# OPENROUTER_API_KEY=sk-or-v1-...      # only for openrouter:<model> members

# --- Slack War Room bot (./slack.sh) ---
# Bot User OAuth Token: api.slack.com/apps -> War Room -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# App-level token with the connections:write scope: Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=xapp-...
# WARROOM_MAX_CONCURRENT=1             # councils at once; extra requests queue
# WARROOM_CRITIQUE_CHARS=1200          # per-reviewer critique length in Slack (0 = full)
